# ---------------------------------------------------------------------------
# Copy this file to .env and fill in what you need. Everything below has a
# safe default so `docker compose up` works out of the box for the LOCAL
# (Ollama) demo path with no cloud credentials at all.
# ---------------------------------------------------------------------------

# --- Persistence -------------------------------------------------------
# Used automatically inside docker-compose (built from POSTGRES_* below).
# For running the backend OUTSIDE docker (e.g. `uvicorn app.main:app`), this
# is what's actually read — defaults to a local SQLite file, zero setup.
DATABASE_URL=sqlite:///./data/app.db

POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny_growth_assistant

# --- LLM provider toggle (REQUIRED: mandatory local demo path) --------
# "ollama" | "anthropic"
LLM_PROVIDER=ollama

# Optional: if set, a request to the unavailable primary provider will
# transparently retry against this one INSTEAD of failing with a clear 503.
# Leave blank to keep the default "fail loudly" behavior (see architecture.md §6).
LLM_FALLBACK_PROVIDER=

# --- Anthropic (cloud) --------------------------------------------------
# Only required if LLM_PROVIDER=anthropic (or as a fallback target).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Ollama (local, mandatory for the demo) -----------------------------
# Run natively on your host: `ollama serve` then `ollama pull llama3.1:8b`
# (or any model that runs comfortably on your machine — change OLLAMA_MODEL
# to match). Inside docker-compose this points at the host machine.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# --- Retrieval / ingestion -----------------------------------------------
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts
TRANSCRIPTS_DIR=./data/transcripts
INDEX_DB_PATH=./data/index.db
RETRIEVAL_TOP_K=6
CHUNK_TARGET_CHARS=1000

# --- App -----------------------------------------------------------------
CORS_ORIGINS=*
LOG_LEVEL=INFO
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1500
